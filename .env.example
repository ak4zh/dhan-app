# Copy this to .env and fill in real values. Never commit .env.

# better-auth
BETTER_AUTH_SECRET=          # generate: openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:5173
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# SQLite file path
DB_PATH=./data/app.db

# Broker-secret encryption (used by src/lib/server/crypto.ts)
ENCRYPTION_KEY=              # generate: openssl rand -hex 32

# Dhan (master account) — https://dhanhq.co/docs/v2/authentication/
DHAN_CLIENT_ID=
# Preferred: lets the app auto-refresh a fresh 24h token daily.
# Requires "TOTP for API access" enabled once in Dhan Web (Profile > DhanHQ Trading APIs).
DHAN_PIN=
DHAN_TOTP_SECRET=
# Fallback: a token pasted manually from Dhan Web, used until auto-refresh has run once.
DHAN_ACCESS_TOKEN=

TELEGRAM_BOT_TOKEN=
# Target Telegram Chat ID for real-time trade alerts (user ID or channel ID)
TELEGRAM_CHAT_ID=
# Comma-separated Telegram numeric user IDs allowed to control the bot.
# Get your ID from @userinfobot on Telegram.
TELEGRAM_ADMIN_USER_IDS=
# Public HTTPS URL this app is reachable at (CapRover app URL), used for
# the Telegram webhook and as the Mini App url. e.g. https://dhan-copier.yourdomain.com
PUBLIC_URL=
# Random long string, used to validate Telegram webhook + Mini App requests
WEBHOOK_SECRET=